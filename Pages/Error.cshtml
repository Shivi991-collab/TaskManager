@page
@model ErrorModel

<div class="container mt-5">
    <h1 class="page-title h3 text-danger">Something went wrong</h1>
    <p>An unexpected error occurred. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-ledger-primary">Back to tasks</a>
</div>
